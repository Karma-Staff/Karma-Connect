# Copy this file to .env for local development.
#
# 1) Anthropic key — SERVER-SIDE ONLY (no VITE_ prefix), so it never ships to the browser.
#    The dev server and the Vercel /api/claude proxy read this.
ANTHROPIC_API_KEY=your_anthropic_key_here

# 2) Supabase (real accounts). Get these from your Supabase project -> Settings -> API.
#    Leave blank for quick local use (per-browser email+password, no Supabase).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Production (Vercel) — ALL server-side only, NEVER VITE_-prefixed ---
# SUPABASE_JWT_SECRET=...            # Supabase -> Settings -> API -> JWT Secret (verifies logins server-side)
# SUPABASE_URL=https://xxx.supabase.co   # server copy of the project URL (issuer check + usage inserts)
# SUPABASE_SERVICE_ROLE_KEY=...      # Supabase service_role key — usage accounting INSERTs. NEVER expose to the browser.
#
# Rate limiting + token quotas + response cache (optional but recommended for production).
# Create a free Upstash Redis DB -> copy the REST URL + token:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Tunables (optional, defaults shown):
# RATE_LIMIT_RPM=20                 # requests per user per minute
# DAILY_TOKEN_BUDGET=2000000        # tokens per user per day
# RESPONSE_CACHE_TTL=600            # seconds to cache identical requests
# BREAKER_FAILS=12                  # upstream failures/min before the global circuit breaker opens
# BREAKER_COOLDOWN=30               # seconds the breaker stays open
#
# Sign-up is OPEN by default: anyone who creates an account can use the app.
# To LOCK IT DOWN (recommended for a public URL — protects your API billing),
# set ONE of these on the server and only matching users are allowed:
# ALLOWED_EMAIL_DOMAIN=karmastaff.com          # only this email domain
# ALLOWED_EMAILS=a@karmastaff.com,b@karmastaff.com   # exact list (overrides the domain)
