# Copy this file to .env for local development.
#
# 1) Anthropic key — SERVER-SIDE ONLY (no VITE_ prefix), so it never ships to the browser.
#    The dev server and the Vercel /api/claude proxy read this.
ANTHROPIC_API_KEY=your_anthropic_key_here

# 2) Supabase (team login). Get these from your Supabase project -> Settings -> API.
#    Leave blank for quick local use (no login gate locally).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Domain hint shown on the login screen (client-side UX only; the real check is server-side).
VITE_ALLOWED_EMAIL_DOMAIN=karmastaff.com

# --- Set these in Vercel (production); not needed for local dev ---
# SUPABASE_JWT_SECRET=...               # Supabase -> Settings -> API -> JWT Secret (verifies logins server-side)
# ALLOWED_EMAIL_DOMAIN=karmastaff.com   # only emails on this domain may use the app
