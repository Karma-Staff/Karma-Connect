{
  "name": "karma-connect-dialer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Karma Connect softphone as an always-on-top desktop app — floats over every application.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.karmastaff.karmaconnect.dialer",
    "productName": "Karma Connect Dialer",
    "files": ["main.js", "preload.js", "icons/**"],
    "win": { "target": "nsis", "icon": "icons/icon.ico" },
    "mac": { "target": "dmg", "icon": "icons/icon.icns" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
