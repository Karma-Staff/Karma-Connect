{
  "manifest_version": 3,
  "name": "Karma Connect Dialer",
  "version": "0.1.0",
  "description": "A floating Karma Connect softphone on every website — drag it anywhere, and call a number from any page.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Karma Connect Dialer — show / hide" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["frame.html", "frame.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
