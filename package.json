{
  "name": "karma-connect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n SERVER,VITE -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server.js --dev",
    "dev:server:watch": "node --watch server.js --dev",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node scripts/leads-migrate.mjs && node server.js",
    "db:init": "node scripts/db-init.mjs",
    "agent": "node agent/run.cjs",
    "agent:login": "node agent/run.cjs --login",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "leads:migrate": "node leads/server/migrate.js",
    "leads:migrate:status": "node leads/server/migrate.js --status",
    "zoho:token": "node scripts/zoho-token.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@workos-inc/node": "^10.9.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
